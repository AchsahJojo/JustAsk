{
  "name": "justask",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:ext": "npm run build -w @justask/extension",
    "fixtures": "node apps/fixtures/serve.mjs",
    "planner:dev": "npm run dev -w @justask/backend",
    "test:e2e": "npm run build -w @justask/extension && npm run build:e2e -w @justask/extension && node e2e/run.mjs",
    "test:convex": "node packages/backend/test/convex.int.mjs"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "puppeteer": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
