# Copy to .env (never commit .env). No API keys here: secrets live only in Convex env.
# Convex client URL (live queries, mutations, actions).
VITE_CONVEX_URL=https://aromatic-salamander-969.convex.cloud
# Planner base URL: Convex HTTP actions (POST /plan). For local dev use http://localhost:8787.
VITE_PLANNER_URL=https://aromatic-salamander-969.convex.site
# Origin of the JustAsk link page for "Link my browsers" (opens <origin>/link#justask-link=<code>). Optional.
VITE_LINK_ORIGIN=
