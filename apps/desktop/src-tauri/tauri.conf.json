{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JustAsk",
  "version": "0.1.0",
  "identifier": "app.justask.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "JustAsk", "width": 500, "height": 800, "minWidth": 380, "minHeight": 560, "center": true }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"] }
}
