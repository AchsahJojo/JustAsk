# Where the extension sends planStep requests (POST /plan).
# Local dev planner: http://localhost:8787   Convex: your deployment's HTTP actions URL (https://<name>.convex.site)
VITE_PLANNER_URL=http://localhost:8787
# Convex client URL for pairing and tasks (https://<name>.convex.cloud). Leave empty to skip accounts.
VITE_CONVEX_URL=

# Origin of the JustAsk link page (e.g. https://justask.app). The desktop app opens
# <origin>/link#justask-link=<code> in each browser; the extension only honours that
# fragment on this exact origin. Leave empty to turn link-by-URL off.
VITE_LINK_ORIGIN=
